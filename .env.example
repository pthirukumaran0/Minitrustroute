# TrustRoute Environment Configuration Example
# Copy this file to .env.local and update with your credentials

# Application Port and Mode
PORT=3000
NODE_ENV=development

# MongoDB Connection URI (Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/trustroute

# Neo4j Graph Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

