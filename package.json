{
  "name": "trustroute",
  "version": "1.0.0",
  "private": true,
  "description": "TrustRoute - AI-Powered Secure Cross-Border Payment Router",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "test:phase1": "npm --prefix backend run test:phase1",
    "test:phase2": "npm --prefix backend run test:phase2",
    "seed:demo": "npm --prefix backend run seed:demo"
  }
}
