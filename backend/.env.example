# TrustRoute Backend Configuration Template
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/trustroute

# Neo4j Graph Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Administrative Secret Key for Rail Toggles
ADMIN_KEY=TRUSTROUTE-ADMIN-2026

# CAMARA Telecom Open Gateway Configuration
# Operating Modes: mock | sandbox | live
CAMARA_MODE=mock
CAMARA_BASE_URL=https://api.sandbox.telecom-provider.com
CAMARA_AUTH_URL=https://api.sandbox.telecom-provider.com/oauth2/v1/token
CAMARA_CLIENT_ID=
CAMARA_CLIENT_SECRET=
CAMARA_SCOPE=sim-swap:check number-verification:verify
CAMARA_API_KEY=
CAMARA_TIMEOUT_MS=5000
